{
  "redirects": [
    {
      "source": "/company_profile",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/company_profile/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/company",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/company/",
      "destination": "/about",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
